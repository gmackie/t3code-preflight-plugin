{
  "schemaVersion": 2,
  "id": "com.t3code.preflight",
  "displayName": "Preflight release cockpit",
  "version": "0.3.0",
  "description": "Track app readiness and release checks in Preflight, and run a human-approved release review.",
  "mcpServer": {
    "name": "preflight",
    "transport": {
      "type": "stdio",
      "command": "bun",
      "args": ["${pluginRoot}/src/mcp.ts"],
      "env": [
        {
          "name": "PREFLIGHT_ENDPOINT",
          "value": "https://preflight.forgegraf.com",
          "title": "Preflight endpoint"
        },
        {
          "name": "PREFLIGHT_TOKEN",
          "value": "",
          "sensitive": true,
          "title": "Preflight token"
        },
        {
          "name": "PREFLIGHT_POLL_SECONDS",
          "value": "60",
          "title": "Refresh interval in seconds (15-3600)"
        },
        {
          "name": "PREFLIGHT_PLUGIN_STATE_PATH",
          "value": "",
          "title": "Shared release review state file",
          "description": "Optional absolute SQLite path, shared by the server and agent copies."
        }
      ]
    }
  },
  "contributes": {
    "panels": [
      {
        "id": "preflight-readiness",
        "title": "App readiness",
        "scope": "project",
        "resourceUri": "ui://preflight/readiness.html",
        "tool": { "name": "preflight_readiness", "arguments": {} }
      },
      {
        "id": "preflight-releases",
        "title": "Release status",
        "scope": "thread",
        "resourceUri": "ui://preflight/readiness.html",
        "tool": { "name": "preflight_readiness", "arguments": {} }
      }
    ],
    "commands": [
      {
        "id": "preflight-open-readiness",
        "title": "Preflight: Open app readiness",
        "panel": "preflight-readiness"
      },
      {
        "id": "preflight-open-releases",
        "title": "Preflight: Open release status",
        "panel": "preflight-releases"
      }
    ]
  },
  "t3Tools": []
}
